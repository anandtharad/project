# Copy to .env and adjust. Never commit .env. Placeholders only.

APP_ENV=development
LOG_LEVEL=INFO

# Used when running the app on the host. compose.yaml overrides it for containers.
DATABASE_URL=postgresql+asyncpg://companion:companion@localhost:5432/companion

# DEVELOPMENT-ONLY authentication: comma-separated handle:token pairs.
# Choose your own long random tokens; this is not production auth.
DEV_AUTH_TOKENS=alice:replace-with-a-long-random-token,bob:replace-with-another-token

# Generative LLM - see docs/providers.md for every provider, its default model
# and its key variable. "fake" is a labeled development stub (no model call).
# One of: anthropic, openai, groq, gemini, xai, qwen, deepseek, openrouter,
#         together, mistral, ollama, openai_compatible, fake
GENERATION_PROVIDER=groq
# Leave empty to use the provider's default model (required for deepseek,
# openrouter, together, ollama, openai_compatible).
GENERATION_MODEL=
# Only for openai_compatible (required) or to override a preset's endpoint.
GENERATION_BASE_URL=
# Applies to whichever provider is selected; otherwise the provider's own
# key below is used.
GENERATION_API_KEY=
GENERATION_TIMEOUT_SECONDS=45
GENERATION_MAX_RETRIES=2
# none | low | medium | high | xhigh | max, or "off" to send no effort
# parameter. Empty = provider default ("low" for models with known controls).
# Each adapter maps it to its provider's own control (or ignores it, with a
# startup warning, where the provider has none).
GENERATION_EFFORT=
# Leave empty: many current models reject sampling parameters.
GENERATION_TEMPERATURE=
# Anthropic only.
GENERATION_REFUSAL_FALLBACK=default
# Empty = provider default (Groq's defaults are sized for its free tier).
MAX_OUTPUT_TOKENS=

# Provider API keys - set only the one(s) you use. Never commit real keys.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=

# Conversation state: one structured LLM call before each reply updates the
# notes (topic, goal, open questions...). Empty model = the generation model.
# On Groq's free tier, qwen/qwen3.8-27b (preview) uses a separate rate limit.
STATE_EXTRACTION_ENABLED=true
STATE_EXTRACTION_MODEL=
STATE_EXTRACTION_TIMEOUT_SECONDS=10

# Decision model (Jev questions: conversation mode, response strategy,
# retrieval). off | laya | jev. Decisions run in shadow mode (stored, not
# acted on) until an evaluation sets thresholds; see docs/decisions.md.
DECISION_PROVIDER=off
# Self-hosted Laya (scripts/dev.py laya, or docker compose --profile laya up -d laya).
# Choose any long random key; the server and the app use the same one.
LAYA_BASE_URL=http://localhost:8100
LAYA_API_KEY=
LAYA_MODEL=english
# TypeSafe Jev (hosted, early access).
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# Laya on CPU needs ~2-3 s for the three questions; Jev is much faster.
DECISION_TIMEOUT_SECONDS=5

TURN_DEADLINE_SECONDS=90
STALE_TURN_SECONDS=150
MAX_INPUT_CHARACTERS=8000
MAX_REQUEST_BYTES=65536
# Empty = provider default.
MAX_CONTEXT_TOKENS=
HISTORY_MAX_MESSAGES=50
MAX_RESPONSE_CHARACTERS=8000

COMPANION_PROMPT_VERSION=1.1.0
STATE_PROMPT_VERSION=1.0.0
EXPOSE_TIMING_METADATA=true

# Tests (host): a role allowed to CREATE DATABASE.
TEST_DATABASE_URL=postgresql+asyncpg://companion:companion@localhost:5432/companion
