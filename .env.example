# Copy to .env and adjust. Never commit .env. Placeholders only.

APP_ENV=development
LOG_LEVEL=INFO

# Used when running the app on the host. compose.yaml overrides it for containers.
DATABASE_URL=postgresql+asyncpg://companion:companion@localhost:5432/companion

# DEVELOPMENT-ONLY authentication: comma-separated handle:token pairs.
# Choose your own long random tokens; this is not production auth.
DEV_AUTH_TOKENS=alice:replace-with-a-long-random-token,bob:replace-with-another-token

# Generative LLM - see docs/providers.md for every provider, its default model
# and its key variable. "fake" is a labeled development stub (no model call).
# One of: anthropic, openai, groq, gemini, xai, qwen, deepseek, openrouter,
#         together, mistral, ollama, openai_compatible, fake
GENERATION_PROVIDER=groq
# Leave empty to use the provider's default model (required for deepseek,
# openrouter, together, ollama, openai_compatible).
GENERATION_MODEL=
# Only for openai_compatible (required) or to override a preset's endpoint.
GENERATION_BASE_URL=
# Applies to whichever provider is selected; otherwise the provider's own
# key below is used.
GENERATION_API_KEY=
GENERATION_TIMEOUT_SECONDS=45
GENERATION_MAX_RETRIES=2
# none | low | medium | high | xhigh | max, or "off" to send no effort
# parameter. Empty = provider default ("low" for models with known controls).
# Each adapter maps it to its provider's own control (or ignores it, with a
# startup warning, where the provider has none).
GENERATION_EFFORT=
# Leave empty: many current models reject sampling parameters.
GENERATION_TEMPERATURE=
# Anthropic only.
GENERATION_REFUSAL_FALLBACK=default
# Empty = provider default (Groq's defaults are sized for its free tier).
MAX_OUTPUT_TOKENS=

# Provider API keys - set only the one(s) you use. Never commit real keys.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=

# Conversation state: one structured LLM call before each reply updates the
# notes (topic, goal, open questions...). Empty model = the generation model.
# On Groq's free tier, qwen/qwen3.8-27b (preview) uses a separate rate limit.
STATE_EXTRACTION_ENABLED=true
STATE_EXTRACTION_MODEL=
STATE_EXTRACTION_TIMEOUT_SECONDS=10

# Memory (docs/memory.md): after each reply, one structured LLM call proposes
# memory candidates; code decides what is stored. Empty model = the generation
# model. Memories are retrieved into later conversations and can be listed or
# deleted via /v1/users/me/memories.
MEMORY_ENABLED=true
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_MODEL=
MEMORY_PROMPT_VERSION=1.1.0
MEMORY_MAX_RETRIEVED=5
# Chosen for the local embedding model (docs/memory.md); re-tune for others.
MEMORY_MIN_SEMANTIC=0.49
MEMORY_RETENTION_DAYS=365
# Embeddings for semantic memory search: local (fastembed on CPU, no key; the
# first start downloads about 65 MB), openai, gemini, or none (full-text only).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
# Keep the local model out of the temp folder so it isn't downloaded again.
EMBEDDING_CACHE_DIR=.cache/fastembed

# Knowledge lookups for information requests (docs/rag.md). Ingest the
# reviewed corpus once: uv run python scripts/ingest_knowledge.py
KNOWLEDGE_ENABLED=true
KNOWLEDGE_MAX_RESULTS=3
# Relevance threshold for the default local embedding model.
KNOWLEDGE_MIN_SEMANTIC=0.70
KNOWLEDGE_MIN_LEXICAL=0.46
KNOWLEDGE_TIMEOUT_SECONDS=3

# Safety layer (docs/safety.md). The classifier runs on Groq when
# GROQ_API_KEY is set ("auto"), on its own model and free-tier limits;
# without it every turn runs in degraded mode (patterns only).
SAFETY_ENABLED=true
SAFETY_CLASSIFIER_PROVIDER=auto
SAFETY_CLASSIFIER_MODEL=openai/gpt-oss-safeguard-20b
# Verified crisis resources: IN, US, GB, or empty for the generic set.
SAFETY_REGION=
SAFETY_OUTPUT_LLM_CHECK=true

# Decision model (Jev questions: conversation mode, response strategy,
# retrieval). off | laya | jev | llm. Decisions run in shadow mode (stored, not
# acted on) until an evaluation sets thresholds for the exact provider, model
# and prompt; see docs/decisions.md.
DECISION_PROVIDER=off
# Self-hosted Laya (scripts/dev.py laya, or docker compose --profile laya up -d laya).
# Choose any long random key; the server and the app use the same one.
LAYA_BASE_URL=http://localhost:8100
LAYA_API_KEY=
LAYA_MODEL=english
# TypeSafe Jev (hosted, early access).
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# LLM decision provider (DECISION_PROVIDER=llm): a separate LLM answers the
# same typed questions with integer weights that the app normalises (stated
# weights, not calibrated probabilities). It sends the latest message and up
# to 4 earlier ones to this provider on every turn (~1.5K tokens on
# gpt-oss-20b) and needs that provider's own key above (e.g. GROQ_API_KEY);
# GENERATION_API_KEY is used only if it is also the reply provider. Keep it a
# different model from the reply model: on Groq's free tier each model has its
# own rate limit. Changing the provider, model or prompt version means no
# thresholds until it is evaluated again.
DECISION_LLM_PROVIDER=groq
DECISION_LLM_MODEL=openai/gpt-oss-20b
# none | low | medium | high | xhigh | max, or "off" for models without
# reasoning controls.
DECISION_LLM_EFFORT=low
DECISION_LLM_MAX_OUTPUT_TOKENS=1024
DECISION_PROMPT_VERSION=1.0.0
# Laya on CPU needs ~2-3 s for the three questions; Jev is much faster. A
# hosted LLM needs a few seconds too.
DECISION_TIMEOUT_SECONDS=5

TURN_DEADLINE_SECONDS=90
STALE_TURN_SECONDS=150
# Per-user message limits across all conversations (0 = off).
USER_MESSAGES_PER_MINUTE=20
USER_MESSAGES_PER_DAY=1000
MAX_INPUT_CHARACTERS=8000
MAX_REQUEST_BYTES=65536
# Empty = provider default.
MAX_CONTEXT_TOKENS=
HISTORY_MAX_MESSAGES=50
MAX_RESPONSE_CHARACTERS=8000

COMPANION_PROMPT_VERSION=1.7.0
STATE_PROMPT_VERSION=1.0.0
EXPOSE_TIMING_METADATA=true

# Tests (host): a role allowed to CREATE DATABASE.
TEST_DATABASE_URL=postgresql+asyncpg://companion:companion@localhost:5432/companion
